{
  "name": "@hugobiotech/vision-bridge",
  "version": "0.2.1",
  "description": "Local MCP bridge for fixed Qwen3-VL-Plus visual image analysis",
  "type": "module",
  "bin": {
    "vision-bridge": "bin/vision-bridge.mjs"
  },
  "files": [
    "bin",
    "contract",
    "src/npm-server.mjs",
    "src/vision_bridge/*.py",
    "src/vision_bridge/py.typed",
    "pyproject.toml",
    "uv.lock",
    "README.md"
  ],
  "scripts": {
    "generate:mcp-contract": "uv run python scripts/generate_mcp_contract.py",
    "check:mcp-contract": "uv run python scripts/generate_mcp_contract.py --check",
    "test:node": "node --test npm-tests/*.test.mjs",
    "test:python": "uv run pytest",
    "test": "npm run check:mcp-contract && npm run test:node && npm run test:python",
    "prepack": "npm test"
  },
  "keywords": [
    "mcp",
    "vision",
    "image-analysis",
    "qwen3-vl-plus"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}
