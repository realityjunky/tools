{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hugobiotech.com/schemas/vision-bridge-mcp-manifest.schema.json",
  "title": "Vision Bridge MCP Contract Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "contract_version",
    "advertisement",
    "generated_from",
    "server",
    "tools"
  ],
  "properties": {
    "$schema": {
      "const": "./manifest.schema.json"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "advertisement": {
      "const": "static"
    },
    "generated_from": {
      "const": "server.list_tools"
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "transport"],
      "properties": {
        "name": {
          "const": "vision-bridge"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "transport": {
          "const": "stdio"
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "inputSchema"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        },
        "annotations": {
          "type": "object"
        },
        "icons": {
          "type": "array"
        },
        "meta": {
          "type": "object"
        },
        "execution": {
          "type": "object"
        }
      }
    }
  }
}
